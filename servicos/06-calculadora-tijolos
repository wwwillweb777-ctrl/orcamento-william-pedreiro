<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Tijolos - William Pedreiro</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
        body { background: #f0f4f8; padding: 10px; }
        .pagina { max-width: 450px; margin: 0 auto; background: #002f6c; padding: 20px; border-radius: 20px; border-top: 4px solid #D4AF37; color: #fff; }
        h1 { font-size: 26px; color: #fff; text-align: center; margin-bottom: 20px; }
        
        .info-medida {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid #D4AF37;
            border-radius: 8px;
            padding: 15px;
            margin: 15px 0;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            color: #fff;
        }
        .info-tijolo {
            background: rgba(150, 75, 0, 0.3);
            border: 2px solid #ff9900;
            border-radius: 10px;
            padding: 15px;
            margin: 20px 0;
            text-align: center;
            line-height: 1.8;
            font-size: 16px;
            color: #fff;
        }
        
        label { font-weight: bold; color: #fff; display: block; margin-bottom: 5px; margin-top: 15px; }
        input { width: 100%; padding: 12px; border: 2px solid #D4AF37; border-radius: 8px; font-size: 16px; margin-bottom: 10px; background: rgba(255,255,255,0.9); }
        
        .btn { width: 100%; padding: 15px; border: none; border-radius: 10px; font-size: 20px; font-weight: bold; color: #fff; cursor: pointer; margin-top: 10px; }
        .btn-calcular { background: #ff8800; }
        .btn-salvar { background: #17a2b8; }
        .btn-whatsapp { background: #25d366; }
        .btn-resumo { background: #6f42c1; }
        .btn-proximo { background: #007bff; }
        .btn-voltar { background: #d32f2f; }
        
        .resultado {
            background: rgba(0, 0, 0, 0.3);
            border: 2px solid #ffcc00;
            border-radius: 10px;
            padding: 20px;
            margin-top: 25px;
            text-align: center;
            font-size: 20px;
            line-height: 2;
            color: #fff;
            display: none;
        }
        .valor-final { color: #0f0; font-weight: bold; font-size: 26px; }
        .aviso-perda { font-size: 14px; color: #aaa; margin-top: 15px; }
        
        .campo-whats {
            background: rgba(255,255,255,0.1);
            border: 2px solid #25d366;
            border-radius: 10px;
            padding: 15px;
            margin-top: 20px;
            display: none;
        }
        .campo-whats label { margin-top: 0; color: #25d366; }
    </style>
</head>
<body>

<div class="pagina">
    <h1>🧱 CALCULADORA DE TIJOLOS</h1>

    <div class="info-medida">
        <strong>CÁLCULO PARA PAREDES</strong><br>
        ✅ HORIZONTAL × VERTICAL = ÁREA EM M²
    </div>

    <div class="info-tijolo">
        <strong>🧱 TIJOLO DE 10 cm</strong><br>
        • Altura: 19 cm | Largura: 29 cm<br>
        • <strong>1 M² ≈ 18 TIJOLOS</strong>
    </div>

    <div class="info-tijolo">
        <strong>🧱 TIJOLO DE 15 cm</strong><br>
        • Altura: 14 cm | Largura: 29 cm<br>
        • <strong>1 M² ≈ 21 TIJOLOS</strong>
    </div>

    <div class="info-tijolo">
        <strong>⬜ BLOCO DE CONCRETO</strong><br>
        • Altura: 19 cm | Largura: 39 cm<br>
        • <strong>1 M² ≈ 13 BLOCOS</strong>
    </div>

    <label>📏 Medida Horizontal (Comprimento):</label>
    <input type="text" id="medida1" placeholder="Ex: 5,00 metros">

    <label>📏 Medida Vertical (Altura):</label>
    <input type="text" id="medida2" placeholder="Ex: 2,80 metros">

    <button class="btn btn-calcular" onclick="calcularTijolos()">📐 CALCULAR QUANTIDADE</button>

    <div class="resultado" id="areaResultado">
        <p><strong>📏 Área Total da Parede:</strong><br>
        <span class="valor-final" id="metragem">0,00</span> m²</p>
        <hr style="border-color: #ffcc00; margin: 10px 0;">
        <p><strong>🧱 Tijolo 10 cm:</strong><br>
        <span class="valor-final" id="qtde10">0</span> unidades</p>
        <p><strong>🧱 Tijolo 15 cm:</strong><br>
        <span class="valor-final" id="qtde15">0</span> unidades</p>
        <p><strong>⬜ Bloco de Concreto:</strong><br>
        <span class="valor-final" id="qtdeBlocos">0</span> unidades</p>
        <p class="aviso-perda">* Considere comprar 5% a mais para perdas e recortes</p>
    </div>

    <button class="btn btn-salvar" onclick="salvarItem()">💾 SALVAR</button>
    <button class="btn btn-whatsapp" onclick="mostrarCampoWhatsApp()">📲 ENVIAR PELO WHATSAPP</button>
    <button class="btn btn-resumo" onclick="window.location.href='08-resumo-geral.html'">📊 VER RESUMO GERAL</button>

    <!-- ✅ BOTÃO PRÓXIMO → GESSO (SÓ "PRÓXIMO") -->
    <button class="btn btn-proximo" onclick="window.location.href='06-gesso.html'">PRÓXIMO</button>

    <div class="campo-whats" id="area-whats">
        <label>📱 Seu WhatsApp:</label>
        <input type="tel" id="whats-cliente" placeholder="Ex: 31999998888">
        <button class="btn btn-whatsapp" onclick="enviarWhatsApp()">✅ CONFIRMAR E ENVIAR</button>
    </div>

    <!-- ✅ BOTÃO VOLTAR → CONCRETO (fixo, não depende de histórico) -->
    <button class="btn btn-voltar" onclick="window.location.href='05-concreto.html'">VOLTAR</button>
</div>

<script>
const SEU_NUMERO = "5531990721928";
let dadosSalvos = null;

function obterValor(id) {
    const valor = document.getElementById(id).value.replace(',', '.');
    return parseFloat(valor) || 0;
}

function formatarNumero(valor, decimais = 2) {
    return valor.toLocaleString('pt-BR', { 
        minimumFractionDigits: decimais, 
        maximumFractionDigits: decimais 
    });
}

function calcularTijolos() {
    const larg = obterValor('medida1');
    const alt = obterValor('medida2');

    if(larg <= 0 || alt <= 0) {
        alert("⚠️ Digite medidas válidas maiores que zero!");
        return;
    }

    const area = larg * alt;
    
    document.getElementById('metragem').textContent = formatarNumero(area) + ' m²';
    document.getElementById('qtde10').textContent = Math.ceil(area * 18);
    document.getElementById('qtde15').textContent = Math.ceil(area * 21);
    document.getElementById('qtdeBlocos').textContent = Math.ceil(area * 13);

    document.getElementById('areaResultado').style.display = 'block';
    document.getElementById('areaResultado').scrollIntoView({ behavior: 'smooth' });

    dadosSalvos = {
        servico: "CALC. TIJOLOS",
        medida: formatarNumero(area) + ' m²',
        valor: "---",
        tijolos10: Math.ceil(area * 18),
        tijolos15: Math.ceil(area * 21),
        blocos: Math.ceil(area * 13)
    };
}

function salvarItem() {
    if(!dadosSalvos) {
        alert("⚠️ Calcule primeiro antes de salvar!");
        return;
    }
    let dadosAcumulados = JSON.parse(localStorage.getItem('orcamentoCompleto') || '[]');
    dadosAcumulados.push({ ...dadosSalvos });
    localStorage.setItem('orcamentoCompleto', JSON.stringify(dadosAcumulados));
    alert(`✅ SALVO! Total de serviços: ${dadosAcumulados.length}`);
}

function mostrarCampoWhatsApp() {
    const todos = JSON.parse(localStorage.getItem('orcamentoCompleto') || '[]');
    if(todos.length === 0 && !dadosSalvos) {
        alert("⚠️ Calcule e salve pelo menos um serviço antes de enviar!");
        return;
    }
    document.getElementById('area-whats').style.display = 'block';
    document.getElementById('area-whats').scrollIntoView({ behavior: 'smooth' });
}

function enviarWhatsApp() {
    const numero = document.getElementById('whats-cliente').value.replace(/\D/g, '');
    if(numero.length < 10) {
        alert("⚠️ Digite seu WhatsApp com DDD! Ex: 31999998888");
        return;
    }

    let todosOsServicos = JSON.parse(localStorage.getItem('orcamentoCompleto') || '[]');
    
    if(dadosSalvos && !todosOsServicos.find(s => s.servico === dadosSalvos.servico)) {
        todosOsServicos.push(dadosSalvos);
    }

    if(todosOsServicos.length === 0) {
        alert("⚠️ Salve pelo menos um serviço!");
        return;
    }

    let mensagem = `📋 *ORÇAMENTO COMPLETO — WILLIAM PEDREIRO*\n`;
    mensagem += `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n`;
    mensagem += `👤 *Cliente:* ${numero}\n\n`;
    mensagem += `📌 *SERVIÇOS:*\n`;

    todosOsServicos.forEach((servico, index) => {
        mensagem += `\n${index + 1}. *${servico.servico}*\n`;
        mensagem += `   📏 Medida: ${servico.medida}\n`;
        if(servico.valor !== "---") mensagem += `   💰 Valor: ${servico.valor}\n`;
        if(servico.tijolos10) mensagem += `   🧱 Tijolo 10cm: ${servico.tijolos10} unidades\n`;
        if(servico.tijolos15) mensagem += `   🧱 Tijolo 15cm: ${servico.tijolos15} unidades\n`;
        if(servico.blocos) mensagem += `   ⬜ Blocos: ${servico.blocos} unidades\n`;
    });

    mensagem += `\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`;

    window.open(`https://wa.me/${SEU_NUMERO}?text=${encodeURIComponent(mensagem)}`, '_blank');
    alert("✅ Orçamento completo! Abrindo WhatsApp...");
}
</script>

</body>
</html>
